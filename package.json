{
  "name": "ninescope",
  "version": "1.0.0",
  "private": true,
  "description": "CVSS 9.0+ vulnerability monitor with a non-intrusive tech-stack exposure scanner",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/build_data.mjs",
    "build:stats": "node scripts/build_data.mjs --stats",
    "probe": "node scripts/probe_sites.mjs",
    "verify": "node scripts/verify_app.js",
    "verify:browser": "node scripts/browser_check.js",
    "verify:all": "node scripts/verify_app.js && node scripts/browser_check.js",
    "verify:live": "node scripts/live_check.js --url=https://nwfella.github.io/ninescope/"
  }
}
